# Postgres connection (local dev: brew postgresql@17; prod: Supabase connection string)
DATABASE_URL=postgres://localhost:5432/someday

# Shared secret the Shortcut / Twilio / scripts send as "Authorization: Bearer ..."
CAPTURE_TOKEN=change-me

# Password for the web UI. Leave blank on your laptop; set it before putting Someday on a public URL.
APP_PASSWORD=

# Where downloaded media, frames and thumbnails live. On Fly this is the mounted volume.
MEDIA_DIR=./data/media
# local (default): serve files from MEDIA_DIR. supabase: mirror each item's folder to a private bucket and serve signed URLs.
MEDIA_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media
# With MEDIA_BACKEND=supabase, set to 0 to delete local copies after upload (small disk), 1 to keep them as a cache.
MEDIA_LOCAL_CACHE=1

# Near-duplicate images: hamming distance on a 64-bit perceptual hash. 0 identical; re-screenshots land 0-5; 8 is a safe default.
NEAR_DUP_THRESHOLD=8

# AI. Set MOCK_AI=1 to run the whole pipeline with stubbed AI (no keys needed).
MOCK_AI=1
ANTHROPIC_API_KEY=
# Only if you want to route through a different Anthropic-compatible endpoint; shell ANTHROPIC_BASE_URL is ignored on purpose.
# SOMEDAY_ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5-5          # live saves (share sheet, SMS)
ANTHROPIC_MODEL_BULK=claude-haiku-5-5      # backfill from folders / Photos
# Optional: transcription (OpenAI Whisper) and embeddings (Voyage). Skipped when blank.
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Optional: Twilio, to accept texted links/photos. Needed to download MMS attachments.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
